Project SportBooking {
  database_type: 'PostgreSQL'
  Note: '9 bảng nghiệp vụ từ PDF + audit_logs từ yêu cầu ảnh. Migration PostgreSQL là nguồn thực thi CHECK, GiST exclusion và partial unique indexes.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name varchar(150) [not null]
  email varchar(254) [not null, unique, note: 'lowercase']
  phone varchar(30)
  password_hash text [not null]
  role varchar(24) [not null, default: 'CUSTOMER', note: 'CUSTOMER | VENUE_MANAGER | ADMIN']
  is_active boolean [not null, default: true]
  token_version integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table sport_venues {
  id uuid [pk, default: `gen_random_uuid()`]
  manager_id uuid [not null, ref: > users.id]
  name varchar(150) [not null]
  address varchar(300) [not null]
  district varchar(100) [not null]
  description text [not null, default: '']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | INACTIVE | MAINTENANCE; direct status edits ADMIN only']
  payment_hold_minutes integer [not null, default: 10, note: 'CHECK 1..10']
  minimum_online_booking_lead_minutes integer [not null, default: 10, note: 'CHECK 10..1440']
  version integer [not null, default: 1, note: 'CHECK >= 1']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table courts {
  id uuid [pk, default: `gen_random_uuid()`]
  venue_id uuid [not null, ref: > sport_venues.id]
  name varchar(150) [not null]
  sport_type varchar(24) [not null, note: 'FOOTBALL | BADMINTON | TENNIS | PICKLEBALL | BASKETBALL']
  hourly_price integer [not null, note: 'VND, CHECK >= 0']
  description text [not null, default: '']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE | INACTIVE | MAINTENANCE']
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (venue_id, name) [unique]
  }
}

Table time_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  court_id uuid [not null, ref: > courts.id]
  slot_date date [not null, note: 'Asia/Ho_Chi_Minh local date']
  start_time time [not null]
  end_time time [not null, note: '60 min, full hour, 06:00..22:00; EXCLUDE overlap per court using btree_gist']
  price integer [not null, note: 'VND, CHECK >= 0']
  status varchar(20) [not null, default: 'AVAILABLE', note: 'AVAILABLE | HELD | BOOKED | UNAVAILABLE']
  held_until timestamptz [note: 'non-null iff status HELD']
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (court_id, slot_date, start_time, end_time) [unique]
    (court_id, slot_date, start_time)
  }
}

Table bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  time_slot_id uuid [not null, ref: > time_slots.id]
  customer_id uuid [ref: > users.id, note: 'required for ONLINE; nullable for walk-in guest']
  customer_name varchar(150)
  customer_phone varchar(30)
  status varchar(30) [not null, default: 'PENDING', note: 'PENDING | CONFIRMED | COMPLETED | EXPIRED | CANCELLED_BY_VENUE']
  source varchar(20) [not null, note: 'ONLINE | WALK_IN | EXTENSION']
  parent_booking_id uuid [ref: > bookings.id, note: 'extension parent; cannot equal own id']
  total_amount integer [not null, note: 'VND snapshot, CHECK >= 0']
  issue_reported_at timestamptz
  issue_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Partial unique time_slot_id WHERE status IN (PENDING, CONFIRMED, COMPLETED). Not expressible as ordinary unique index here.'
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  method varchar(24) [not null, note: 'CASH | BANK_TRANSFER | CREDIT_CARD | E_WALLET']
  transaction_code varchar(150) [not null, unique]
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING | PAID | FAILED | REFUNDED']
  amount integer [not null, note: 'VND, CHECK >= 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Partial unique booking_id WHERE status = PAID; many attempts, one paid attempt.'
}

Table booking_reschedules {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  old_time_slot_id uuid [not null, ref: > time_slots.id]
  new_time_slot_id uuid [not null, ref: > time_slots.id, note: 'CHECK old_time_slot_id <> new_time_slot_id']
  reason text [not null]
  is_venue_issue boolean [not null, default: false]
  requested_by uuid [not null, ref: > users.id]
  processed_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique, ref: > bookings.id]
  amount integer [not null, note: 'VND, full booking amount']
  status varchar(20) [not null, default: 'REQUESTED', note: 'REQUESTED -> APPROVED -> PROCESSING -> COMPLETED']
  reason text [not null]
  requested_by uuid [not null, ref: > users.id]
  processed_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique, ref: > bookings.id]
  rating integer [not null, note: 'CHECK 1..5']
  comment text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_id uuid [ref: > users.id, note: 'nullable for system/job']
  action varchar(100) [not null]
  entity_type varchar(50) [not null]
  entity_id uuid [note: 'polymorphic reference, no FK']
  before_data jsonb
  after_data jsonb
  reason text
  created_at timestamptz [not null, default: `now()`]
  Note: '10th table added for privileged status audit requirement. No password/token hashes in snapshots.'
}
