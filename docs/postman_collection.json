  "item": [
    {
      "name": "1. Auth — login lại theo role cần dùng",
      "item": [
        {
          "name": "Đăng nhập (email/password biến collection)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('JSON envelope', () => pm.expect(pm.response.json()).to.have.property('success'));",
                  "pm.test('Request succeeded', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"token\", pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Thông tin tài khoản",
          "request": {
            "method": "GET",
            "header": [
